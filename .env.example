# 复制为 .env 并填入自己的值(.env 不会被提交); 远程 CI 用 GitHub Secrets。
# --- OpenAI 系 API(必填) ---
OPENAI_API_KEY=
# 走中转/网关时填其地址(官方 API 留空)
OPENAI_BASE_URL=
# --- 抽取模型(可选), 默认 gpt-5.6-sol, 低成本可换 gpt-5.6-terra / gpt-5.6-luna ---
OPENAI_MODEL=
# --- 网关要求的额外请求头(可选), 逗号分隔的 名称:值 ---
# 部分网关靠自定义头做路由, 例如 OpenCode Go 必须有 x-opencode-session:
# OPENAI_EXTRA_HEADERS=x-opencode-session:model-price-scraper
OPENAI_EXTRA_HEADERS=
# --- 媒体页证据预算(可选, 字符), 默认 220000 ---
# 媒体页永远先做无损去重(删掉重复样板行); 去重后仍超过该预算才会抽样,
# 而抽样会丢价格行。调小可省 token, 但请先用 coverage_probe.py 确认覆盖率。
GENERATION_EVIDENCE_BUDGET=
